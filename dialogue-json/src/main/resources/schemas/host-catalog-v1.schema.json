{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundsgg.github.io/library-dialogue/schemas/host-catalog-v1.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9_.:/-]+$"
      },
      "uniqueItems": true
    },
    "conditions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9_.:/-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "arguments": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_.:/-]+$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "text",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "nullable": {
                  "type": "boolean"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "durable": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9_.:/-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "arguments": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_.:/-]+$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "text",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "nullable": {
                  "type": "boolean"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "durable": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "gestures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9_.:/-]+$"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9_.:/-]+$"
      },
      "uniqueItems": true
    },
    "durableOutcomes": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "generation",
    "speakers",
    "conditions",
    "actions",
    "gestures",
    "capabilities"
  ],
  "additionalProperties": false
}
